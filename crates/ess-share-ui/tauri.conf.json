{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EasyScreenShare",
  "version": "0.7.0",
  "identifier": "dev.easyscreenshare.shareui",
  "build": {
    "frontendDist": "ui",
    "features": ["custom-protocol"]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "屏幕共享 · 分享端",
        "width": 760,
        "height": 620,
        "minWidth": 640,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "dev.screenshare",
    "category": "Utility",
    "copyright": "Copyright © 2026",
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
